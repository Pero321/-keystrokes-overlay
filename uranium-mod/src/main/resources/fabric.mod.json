{
  "schemaVersion": 1,
  "id": "uraniummod",
  "version": "${version}",
  "name": "Uranium Ore",
  "description": "Adds uranium ore (stone + deepslate), raw uranium, uranium ingots and storage blocks, with deep underground world generation and a redstone-powered centrifuge that must reach temperature before it refines ore.",
  "authors": [
    "Pero321"
  ],
  "contact": {
    "repo": "https://github.com/Pero321/-keystrokes-overlay"
  },
  "license": "MIT",
  "icon": "assets/uraniummod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.pero.uraniummod.UraniumMod"
    ],
    "client": [
      "net.pero.uraniummod.client.UraniumModClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
